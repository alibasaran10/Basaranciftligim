# Python Analiz Mikroservisi - Ortam Degiskenleri (ORNEK)
# ".env" olarak kopyalayin.

# Sunucu
HOST=0.0.0.0
PORT=8000
ENV=development

# Guvenlik: Node backend bu anahtari "x-service-key" basliginda gonderir.
# Node tarafindaki ANALYTICS_SERVICE_KEY ile AYNI olmalidir.
SERVICE_API_KEY=test-service-key-123

# Node backend'in bu servise erisebilecegi CORS origin(ler)i (virgulle).
ALLOWED_ORIGINS=http://localhost:4000
