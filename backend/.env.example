# ============================================================
#  Akilli Ciftlik Backend - Ortam Degiskenleri (ORNEK)
#  Bu dosyayi ".env" olarak kopyalayin ve degerleri doldurun.
#  ".env" dosyasini ASLA git'e commit etmeyin.
# ============================================================

# --- Sunucu ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# --- MongoDB ---
# Uretimde replica set / sharded cluster kullanin (time-series + olceklenme icin)
MONGODB_URI=mongodb://127.0.0.1:27017/smart_farm
MONGODB_URI_TEST=mongodb://127.0.0.1:27017/smart_farm_test

# --- JWT / Kimlik Dogrulama ---
# Guclu, rastgele degerler kullanin: `openssl rand -hex 64`
JWT_ACCESS_SECRET=degistir_bunu_cok_uzun_rastgele_bir_deger
JWT_REFRESH_SECRET=degistir_bunu_farkli_cok_uzun_rastgele_bir_deger
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
BCRYPT_SALT_ROUNDS=12

# --- Cihaz (ESP32) Kimlik Dogrulama ---
# Ingestion endpoint'i ve MQTT icin cihazlarin kullanacagi API anahtari.
# Uretimde her cihaza ayri anahtar onerilir; bu global fallback anahtaridir.
DEVICE_INGEST_API_KEY=degistir_bunu_cihaz_api_anahtari

# --- CORS ---
# Virgulle ayrilmis izinli origin listesi (frontend adresleri)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Rate Limit ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
INGEST_RATE_LIMIT_MAX=1000

# --- MQTT Broker ---
MQTT_ENABLED=false
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# ESP32'lerin yayin yapacagi konu deseni: farm/<farmId>/device/<mac>/telemetry
MQTT_TELEMETRY_TOPIC=farm/+/device/+/telemetry
MQTT_CLIENT_ID=smart-farm-backend

# --- Konumlandirma Motoru ---
# Bir bolgeyi "tespit edildi" saymak icin gereken minimum RSSI (dBm)
POSITIONING_MIN_RSSI=-85

# --- Alarm Esikleri ---
LOW_BATTERY_THRESHOLD=20
# Anormal ivme buyuklugu esigi (g cinsinden yaklasik)
ABNORMAL_ACCEL_THRESHOLD=2.5

# --- Dosya Yukleme ---
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# --- Python Analiz Mikroservisi (opsiyonel entegrasyon) ---
ANALYTICS_SERVICE_URL=http://127.0.0.1:8000
ANALYTICS_SERVICE_KEY=degistir_bunu_servis_anahtari
